# Local configuration (copy from lab.env.example)
lab.env
!lab.env.example

# Claude Code session state — never commit
.claude/

# Secrets and credentials
pull-secret.txt

# openshift-install binaries (downloaded per y-version)
openshift-install
**/openshift-install

# Keys and certificates
*.key
*.crt
*.pem
*.srl

# All per-run install directories live here (WORKDIR_ROOT default)
/clusters/

# Basename backstops — secret-bearing artifacts regardless of WORKDIR_ROOT
install-config.yaml
install-config.yaml.bak
**/auth/
**/kubeadmin-password
**/metadata.json

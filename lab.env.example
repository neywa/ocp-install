# lab.env.example — copy to lab.env and edit. lab.env is gitignored.
#
#   cp lab.env.example lab.env
#
# This file is sourced by ocp-install.sh. Every line uses the ": ${VAR:=value}"
# form so a value already set in your environment WINS over the value here.
# Overall precedence: built-in defaults < lab.env < environment < CLI flags.

# --- Cluster identity (single source of truth) -------------------------------
: "${CLUSTER_NAME:=rbobek}"        # drives metadata.name, cert SANs, API/console hostnames

# --- AWS / cluster shape -----------------------------------------------------
: "${AWS_REGION:=eu-central-1}"
: "${CONTROL_PLANE_REPLICAS:=1}"
: "${WORKER_REPLICAS:=1}"
: "${CONTROL_PLANE_TYPE:=m6i.xlarge}"
: "${WORKER_TYPE:=m6i.xlarge}"

# --- AWS resource tagging ----------------------------------------------------
: "${OWNER:=rbobek}"               # userTags.owner
: "${PURPOSE:=lab}"                # userTags.purpose
: "${TTL_DAYS:=7}"                 # userTags.expirationDate = today + TTL_DAYS

# --- Binaries / files (repo-relative defaults; no personal absolute paths) ----
: "${OCP_VERSION:=}"               # if set, look for ./<OCP_VERSION>/openshift-install first
: "${WORKDIR_ROOT:=./clusters}"    # fixed parent for per-run install dirs (clusters/<name>-<timestamp>)
: "${PULL_SECRET_FILE:=./pull-secret.txt}"
: "${INSTALL_CONFIG_TEMPLATE:=./install-config-template.yaml}"
: "${CA_KEY_FILE:=./certs/ca.key}"
: "${CA_CERT_FILE:=./certs/ca.crt}"

# --- Argo CD permissions -----------------------------------------------------
# Workload namespaces to scope Argo CD to (managed-by label + monitoring role, no
# cluster-admin). Must match your Argo CD Applications' destination namespaces.
: "${ARGOCD_MANAGED_NAMESPACES:=retro-invaders}"
